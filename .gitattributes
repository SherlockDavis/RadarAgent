# Normalize line endings to LF on checkin
* text=auto eol=lf

# Source files
*.py    text eol=lf diff=python
*.pyx   text eol=lf diff=python
*.yaml  text eol=lf
*.yml   text eol=lf
*.toml  text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.sh    text eol=lf
*.cfg   text eol=lf
*.ini   text eol=lf
Dockerfile      text eol=lf
*.dockerfile    text eol=lf

# Windows-specific
*.bat   text eol=crlf
*.ps1   text eol=crlf

# Binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.zip   binary
*.gz    binary
*.tar   binary
