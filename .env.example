# Copy this file to .env and fill in your real values.
# .env is gitignored — never commit real keys.

# Required: OpenAI API key for OpenAILLMProvider (Phase 1)
OPENAI_API_KEY=sk-...

# Optional: override OpenAI base URL (e.g., for compatible APIs)
# OPENAI_BASE_URL=https://api.openai.com/v1

# Phase 3+ (not required for Phase 1 MVP)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# ANTHROPIC_API_KEY=
