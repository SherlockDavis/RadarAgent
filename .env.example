# Copy this file to .env and fill in your real values.
# .env is gitignored — never commit real keys.

# Phase 1 LLM provider — pick ONE and fill it in.
# settings.yaml's llm.api_key references one of these via ${VAR}.

# DeepSeek (default in settings.yaml; OpenAI-compatible API).
# Get one at https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-...

# OpenAI (uncomment if switching settings.yaml back to OpenAI)
# OPENAI_API_KEY=sk-...

# Phase 3+ (not required for Phase 1 MVP)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Anthropic Claude (set llm.provider: anthropic in settings.yaml to use)
# ANTHROPIC_API_KEY=sk-ant-...

# Phase 4 — deployment (docker-compose + Caddy)
# Domain Caddy issues a TLS cert for and reverse-proxies to the app.
RADAR_DOMAIN=radar.example.com

# Email push (settings.yaml smtp.* references these via ${VAR})
# SMTP_USERNAME=
# SMTP_PASSWORD=

# On a CPU-only VPS, switch settings.yaml embedding.provider to openai
# and reference this key from embedding.api_key (${OPENAI_API_KEY}).
# OPENAI_API_KEY=sk-...
