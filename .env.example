# Copy this file to .env and fill in your real values.
# .env is gitignored — never commit real keys.

# Phase 1 LLM provider — pick ONE and fill it in.
# settings.yaml's llm.api_key references one of these via ${VAR}.

# DeepSeek (default in settings.yaml; OpenAI-compatible API).
# Get one at https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-...

# OpenAI (uncomment if switching settings.yaml back to OpenAI)
# OPENAI_API_KEY=sk-...

# Phase 3+ (not required for Phase 1 MVP)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# ANTHROPIC_API_KEY=
